# ==========================================
# ForensicShield Global Environment Settings
# ==========================================
# SECURITY NOTICE: Never commit active secrets or API keys to repository.

# Safety Flags
SAFE_MODE=true
REAL_DEVICE_OPERATIONS=false

# Environment & Server Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Database Configuration:
# Option 1: SQLite (Local Default)
DATABASE_URL=sqlite:///./forensic_shield.db

# Option 2: Neon Serverless PostgreSQL (Recommended for Cloud Hosting / Production)
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
