SAFE_MODE=true
REAL_DEVICE_OPERATIONS=false
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string

# Database Options:
# 1. SQLite (Local Default)
DATABASE_URL=sqlite:///./forensic_shield.db

# 2. Neon Serverless PostgreSQL (Paste your Neon database connection string here)
# DATABASE_URL=postgresql://alex:AbC123dEf@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
